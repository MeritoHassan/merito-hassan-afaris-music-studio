{% extends 'base.html.twig' %}

{% block title %}Admin posts{% endblock %}

{% block body %}
    <section class="admin-card p-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="h2 mb-1">Gestion des posts</h1>
                <p class="text-muted mb-0">Creation, modification et suppression des actualites.</p>
            </div>
            <a class="btn btn-dark" href="{{ path('app_admin_post_new') }}">Nouveau post</a>
        </div>

        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                <tr>
                    <th>ID</th>
                    <th>Titre</th>
                    <th>Auteur</th>
                    <th>Date</th>
                    <th class="text-end">Actions</th>
                </tr>
                </thead>
                <tbody>
                {% for post in posts %}
                    <tr>
                        <td>{{ post.id }}</td>
                        <td>{{ post.titre }}</td>
                        <td>{{ post.auteur ? post.auteur.username : '—' }}</td>
                        <td>{{ post.dateHeureCreation ? post.dateHeureCreation|date('d/m/Y H:i') : '—' }}</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary" href="{{ path('app_admin_post_show', {id: post.id}) }}">Voir</a>
                            <a class="btn btn-sm btn-outline-primary" href="{{ path('app_admin_post_edit', {id: post.id}) }}">Modifier</a>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="5" class="text-center text-muted">Aucun post</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </section>
{% endblock %}
