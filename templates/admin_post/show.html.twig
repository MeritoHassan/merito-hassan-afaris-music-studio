{% extends 'base.html.twig' %}

{% block title %}{{ post.titre }}{% endblock %}

{% block body %}
    <section class="admin-card p-4">
        <div class="d-flex justify-content-between align-items-start mb-4">
            <div>
                <h1 class="h2 mb-2">{{ post.titre }}</h1>
                <div class="text-muted">
                    {{ post.auteur ? post.auteur.username : '—' }} ·
                    {{ post.dateHeureCreation ? post.dateHeureCreation|date('d/m/Y H:i') : '—' }}
                </div>
            </div>
            <div class="d-flex gap-2">
                <a class="btn btn-outline-primary" href="{{ path('app_admin_post_edit', {id: post.id}) }}">Modifier</a>
                {% include 'admin_post/_delete_form.html.twig' %}
            </div>
        </div>
        <div class="fs-5 lh-lg">{{ post.contenu|nl2br }}</div>
    </section>
{% endblock %}
