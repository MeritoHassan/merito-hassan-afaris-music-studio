{% extends 'base.html.twig' %}

{% block title %}Image #{{ image.id }}{% endblock %}

{% block body %}
    <section class="admin-card p-4">
        <div class="d-flex justify-content-between align-items-start mb-4">
            <div>
                <h1 class="h2 mb-2">{{ image.nomImage }}</h1>
                <div class="text-muted">{{ image.post ? image.post.titre : 'Aucun post' }}</div>
            </div>
            <div class="d-flex gap-2">
                <a class="btn btn-outline-primary" href="{{ path('app_admin_image_edit', {id: image.id}) }}">Modifier</a>
                {% include 'admin_image/_delete_form.html.twig' %}
            </div>
        </div>
        <img class="img-fluid rounded-4 shadow-sm" src="{{ asset(image.chemin) }}" alt="{{ image.nomImage }}">
    </section>
{% endblock %}
