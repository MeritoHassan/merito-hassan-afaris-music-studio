<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Afaris Music Studio{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        :root {
            --afaris-primary: #111827;
            --afaris-accent: #f59e0b;
            --afaris-secondary: #10b981;
            --afaris-muted: #6b7280;
            --afaris-surface: #f3f4f6;
        }

        body {
            background:
                radial-gradient(circle at top right, rgba(245, 158, 11, 0.16), transparent 28%),
                radial-gradient(circle at bottom left, rgba(16, 185, 129, 0.12), transparent 30%),
                linear-gradient(180deg, #f8fafc 0%, #eef2f7 100%);
            color: var(--afaris-primary);
        }

        .navbar-brand {
            font-weight: 700;
            letter-spacing: .04em;
        }

        .page-shell {
            min-height: calc(100vh - 160px);
        }

        .hero-card,
        .section-card,
        .admin-card {
            border: 1px solid rgba(15, 23, 42, 0.08);
            border-radius: 1.25rem;
            background: rgba(255, 255, 255, 0.92);
            box-shadow: 0 20px 45px rgba(15, 23, 42, 0.08);
        }

        .section-title {
            font-size: clamp(1.7rem, 3vw, 2.6rem);
            font-weight: 700;
        }

        .post-cover {
            width: 100%;
            height: 220px;
            object-fit: cover;
        }

        .post-cover-lg {
            width: 100%;
            max-height: 460px;
            object-fit: cover;
            border-radius: 1rem;
        }

        .comment-card {
            border-left: 4px solid #cbd5e1;
        }

        .comment-card.is-reported {
            border-left-color: #dc2626;
            background: #fff1f2;
        }

        .admin-shortcuts a {
            text-decoration: none;
        }

        footer {
            border-top: 1px solid rgba(15, 23, 42, 0.08);
        }
    </style>
    {% block stylesheets %}
        {{ importmap('app') }}
    {% endblock %}
</head>
<body>
<nav class="navbar navbar-expand-lg bg-white border-bottom sticky-top">
    <div class="container">
        <a class="navbar-brand" href="{{ path('app_home') }}">Afaris Music Studio</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="mainNav">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                <li class="nav-item"><a class="nav-link" href="{{ path('app_home') }}">Accueil</a></li>
                <li class="nav-item"><a class="nav-link" href="{{ path('app_postList') }}">Actualites</a></li>
                <li class="nav-item"><a class="nav-link" href="{{ path('app_presentation_client') }}">Le studio</a></li>
                <li class="nav-item"><a class="nav-link" href="{{ path('app_contact') }}">Contact</a></li>
            </ul>
            <div class="d-flex gap-2 align-items-center">
                {% if app.user %}
                    {% if is_granted('ROLE_ADMIN') %}
                        <a class="btn btn-outline-dark btn-sm" href="{{ path('app_admin_post_index') }}">Backoffice</a>
                    {% endif %}
                    <span class="text-muted small">{{ app.user.username }}</span>
                    <a class="btn btn-outline-secondary btn-sm" href="{{ path('app_logout') }}">Deconnexion</a>
                {% else %}
                    <a class="btn btn-outline-secondary btn-sm" href="{{ path('app_login') }}">Connexion</a>
                    <a class="btn btn-warning btn-sm" href="{{ path('app_register') }}">Inscription</a>
                {% endif %}
            </div>
        </div>
    </div>
</nav>

{% if is_granted('ROLE_ADMIN') %}
    <section class="bg-dark-subtle border-bottom py-2">
        <div class="container d-flex flex-wrap gap-2 admin-shortcuts">
            <a class="badge text-bg-dark px-3 py-2" href="{{ path('app_admin_post_index') }}">Actualites</a>
            <a class="badge text-bg-dark px-3 py-2" href="{{ path('app_admin_commentaire_index') }}">Commentaires</a>
            <a class="badge text-bg-dark px-3 py-2" href="{{ path('app_admin_user_index') }}">Membres</a>
            <a class="badge text-bg-dark px-3 py-2" href="{{ path('app_admin_image_index') }}">Medias</a>
        </div>
    </section>
{% endif %}

<main class="page-shell py-4">
    <div class="container">
        {% include 'partials/_flash.html.twig' %}
        {% block body %}{% endblock %}
    </div>
</main>

<footer class="py-4 bg-white">
    <div class="container d-flex flex-column flex-md-row justify-content-between gap-2">
        <div>
            <strong>Afaris Music Studio</strong>
            <div class="text-muted small">Projet Symfony sans CMS pour un studio creatif et ses actualites</div>
        </div>
        <div class="text-muted small">LP DWCA - {{ "now"|date("Y") }}</div>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
