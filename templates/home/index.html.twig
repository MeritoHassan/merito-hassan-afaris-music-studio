{% extends 'base.html.twig' %}

{% block title %}Accueil | Afaris Music Studio{% endblock %}

{% block body %}
    {% set featured = posts|first %}
    {% set secondaryPosts = posts|slice(1, 2) %}

    <section class="hero-card afaris-hero p-4 p-lg-5 mb-5">
        <div class="row align-items-center g-4">
            <div class="col-lg-6">
                <span class="hero-kicker">Afaris Music Studio</span>
                <h1 class="section-title mb-3">Le studio qui relie creation sonore, ateliers et scene locale.</h1>
                <p class="lead text-muted">
                    Afaris Music Studio presente ses ateliers, ses sessions live et ses projets collectifs.
                    Cette vitrine met en avant les actualites, les rencontres et les temps forts du studio dans une interface plus claire et plus credible.
                </p>
                <div class="d-flex gap-2 flex-wrap">
                    <a class="btn btn-dark btn-lg" href="{{ path('app_postList') }}">Voir toutes les actualites</a>
                    <a class="btn btn-outline-secondary btn-lg" href="{{ path('app_presentation_client') }}">Decouvrir le studio</a>
                </div>
                <div class="row g-3 mt-2">
                    <div class="col-sm-4">
                        <div class="hero-stat">
                            <strong>3</strong>
                            <span>actualites recentes mises en avant</span>
                        </div>
                    </div>
                    <div class="col-sm-4">
                        <div class="hero-stat">
                            <strong>1</strong>
                            <span>site Symfony sans CMS</span>
                        </div>
                    </div>
                    <div class="col-sm-4">
                        <div class="hero-stat">
                            <strong>100%</strong>
                            <span>contenu administrable depuis le backoffice</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                {% if featured %}
                    {% set cover = featured.images|first %}
                    {% set coverPath = cover and cover.chemin ? cover.chemin|replace({'/uploads/images/': 'images/', 'uploads/images/': 'images/'}) : 'images/placeholder.svg' %}
                    <article class="featured-story-card">
                        <a class="text-decoration-none text-dark" href="{{ path('app_postList_show', {id: featured.id}) }}">
                            <img
                                class="featured-story-cover"
                                src="{{ asset(coverPath) }}"
                                alt="{{ featured.titre }}"
                            >
                            <div class="p-4">
                                <div class="text-muted small mb-2">
                                    {{ featured.dateHeureCreation|date('d/m/Y H:i') }}
                                    {% if featured.auteur %}· {{ featured.auteur.username }}{% endif %}
                                </div>
                                <h2 class="h3 mb-3">{{ featured.titre }}</h2>
                                {% set excerpt = featured.contenu|striptags %}
                                <p class="text-muted mb-0">
                                    {{ excerpt|length > 190 ? excerpt|slice(0, 190) ~ '...' : excerpt }}
                                </p>
                            </div>
                        </a>
                    </article>

                    {% if secondaryPosts is not empty %}
                        <div class="mini-story-list mt-3">
                            {% for post in secondaryPosts %}
                                <a class="mini-story-link" href="{{ path('app_postList_show', {id: post.id}) }}">
                                    <span class="mini-story-date">{{ post.dateHeureCreation|date('d/m/Y') }}</span>
                                    <strong>{{ post.titre }}</strong>
                                </a>
                            {% endfor %}
                        </div>
                    {% endif %}
                {% else %}
                    <div class="section-card p-4 text-center">
                        <p class="mb-0 text-muted">Aucune actualite n'est encore publiee.</p>
                    </div>
                {% endif %}
            </div>
        </div>
    </section>

    <section class="section-card p-4 p-lg-5 mb-4">
        <div class="row g-3">
            <div class="col-md-4">
                <div class="info-tile h-100">
                    <h2 class="h5 mb-2">Ateliers</h2>
                    <p class="text-muted mb-0">Des initiations, rencontres et sessions pratiques autour de la production sonore.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="info-tile h-100">
                    <h2 class="h5 mb-2">Scene locale</h2>
                    <p class="text-muted mb-0">Le studio valorise les artistes invites et les projets collectifs portes par la communaute.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="info-tile h-100">
                    <h2 class="h5 mb-2">Backoffice</h2>
                    <p class="text-muted mb-0">Actualites, commentaires, utilisateurs et medias peuvent etre geres depuis l'administration.</p>
                </div>
            </div>
        </div>
    </section>

    <section class="section-card p-4 p-lg-5">
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
            <div>
                <h2 class="h3 mb-1">Dernieres publications</h2>
                <p class="text-muted mb-0">Une vitrine dynamique pour les ateliers, rencontres et sessions du studio.</p>
            </div>
            <a class="btn btn-outline-dark" href="{{ path('app_postList') }}">Toutes les actualites</a>
        </div>
        <div class="row g-4">
            {% for post in posts %}
                <div class="col-md-6 col-xl-4">
                    {% include 'partials/_post_card.html.twig' with { post: post } %}
                </div>
            {% else %}
                <div class="col-12">
                    <p class="text-muted mb-0">Aucun post a afficher.</p>
                </div>
            {% endfor %}
        </div>
    </section>
{% endblock %}
