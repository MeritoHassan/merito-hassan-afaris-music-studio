{% extends 'base.html.twig' %}

{% block title %}Admin commentaires{% endblock %}

{% block body %}
    <section class="admin-card p-4">
        <div class="mb-4">
            <h1 class="h2 mb-1">Gestion des commentaires</h1>
            <p class="text-muted mb-0">Moderation des commentaires et suivi des signalements.</p>
        </div>

        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                <tr>
                    <th>ID</th>
                    <th>Commentaire</th>
                    <th>Auteur</th>
                    <th>Post</th>
                    <th>Signalement</th>
                    <th class="text-end">Actions</th>
                </tr>
                </thead>
                <tbody>
                {% for commentaire in commentaires %}
                    <tr>
                        <td>{{ commentaire.id }}</td>
                        <td>{{ commentaire.contenu|length > 60 ? commentaire.contenu|slice(0, 60) ~ '...' : commentaire.contenu }}</td>
                        <td>{{ commentaire.auteur ? commentaire.auteur.username : '—' }}</td>
                        <td>{{ commentaire.post ? commentaire.post.titre : '—' }}</td>
                        <td>
                            <span class="badge {{ commentaire.signale ? 'text-bg-danger' : 'text-bg-success' }}">
                                {{ commentaire.signale ? 'Signale' : 'Normal' }}
                            </span>
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-2 flex-wrap justify-content-end">
                                <a class="btn btn-sm btn-outline-secondary" href="{{ path('app_admin_commentaire_show', {id: commentaire.id}) }}">Voir</a>
                                <a class="btn btn-sm btn-outline-primary" href="{{ path('app_admin_commentaire_edit', {id: commentaire.id}) }}">Modifier</a>
                                <form method="post" action="{{ path('app_admin_commentaire_toggle_signal', {id: commentaire.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('toggle_signal' ~ commentaire.id) }}">
                                    <button class="btn btn-sm btn-outline-warning">{{ commentaire.signale ? 'Retirer' : 'Signaler' }}</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="6" class="text-center text-muted">Aucun commentaire</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </section>
{% endblock %}
