{% extends 'base.html.twig' %}

{% block title %}Commentaire #{{ commentaire.id }}{% endblock %}

{% block body %}
    <section class="admin-card p-4">
        <div class="d-flex justify-content-between align-items-start mb-4">
            <div>
                <h1 class="h2 mb-2">Commentaire #{{ commentaire.id }}</h1>
                <div class="text-muted">
                    {{ commentaire.auteur ? commentaire.auteur.username : '—' }} ·
                    {{ commentaire.dateHeureCreation ? commentaire.dateHeureCreation|date('d/m/Y H:i') : '—' }}
                </div>
            </div>
            <div class="d-flex gap-2">
                <a class="btn btn-outline-primary" href="{{ path('app_admin_commentaire_edit', {id: commentaire.id}) }}">Modifier</a>
                {% include 'admin_commentaire/_delete_form.html.twig' %}
            </div>
        </div>

        <p class="mb-3">{{ commentaire.contenu|nl2br }}</p>
        <div class="text-muted">Post lie : {{ commentaire.post ? commentaire.post.titre : '—' }}</div>
        <div class="mt-2">
            <span class="badge {{ commentaire.signale ? 'text-bg-danger' : 'text-bg-success' }}">
                {{ commentaire.signale ? 'Commentaire signale' : 'Commentaire normal' }}
            </span>
        </div>
    </section>
{% endblock %}
