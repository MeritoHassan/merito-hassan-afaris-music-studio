{% extends 'base.html.twig' %}

{% block title %}{{ user.username }}{% endblock %}

{% block body %}
    <section class="admin-card p-4">
        <div class="d-flex justify-content-between align-items-start mb-4">
            <div>
                <h1 class="h2 mb-2">{{ user.username }}</h1>
                <div class="text-muted">{{ user.email }}</div>
            </div>
            <div class="d-flex gap-2">
                <a class="btn btn-outline-primary" href="{{ path('app_admin_user_edit', {id: user.id}) }}">Modifier</a>
                {% include 'admin_user/_delete_form.html.twig' %}
            </div>
        </div>
        <dl class="row mb-0">
            <dt class="col-sm-3">Roles</dt>
            <dd class="col-sm-9">{{ user.roles|join(', ') }}</dd>
            <dt class="col-sm-3">Compte verifie</dt>
            <dd class="col-sm-9">{{ user.isVerified ? 'Oui' : 'Non' }}</dd>
        </dl>
    </section>
{% endblock %}
